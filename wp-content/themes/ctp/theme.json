{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": false,
		"useRootPaddingAwareAlignments": false,
		"layout": {
			"contentSize": "44rem",
			"wideSize": "68rem"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"customGradient": false,
			"palette": [
				{ "slug": "ink", "color": "#131a21", "name": "Ink" },
				{ "slug": "body", "color": "#33414f", "name": "Body text" },
				{ "slug": "muted", "color": "#63717f", "name": "Muted" },
				{ "slug": "brand", "color": "#b4472b", "name": "Brick red" },
				{ "slug": "brand-tint", "color": "#fdf3ef", "name": "Brick tint" },
				{ "slug": "navy", "color": "#16242f", "name": "Slate" },
				{ "slug": "surface", "color": "#ffffff", "name": "White" },
				{ "slug": "surface-alt", "color": "#f6f8f9", "name": "Off white" },
				{ "slug": "line", "color": "#e3e8ec", "name": "Hairline" }
			]
		},
		"typography": {
			"customFontSize": false,
			"lineHeight": true,
			"dropCap": false,
			"fontSizes": [
				{ "slug": "small", "size": "0.9063rem", "name": "Small" },
				{ "slug": "medium", "size": "1.0938rem", "name": "Normal" },
				{ "slug": "large", "size": "1.25rem", "name": "Large" },
				{ "slug": "x-large", "size": "1.6rem", "name": "Extra large" }
			]
		},
		"spacing": {
			"units": [ "px", "rem", "%" ],
			"padding": true,
			"margin": true
		},
		"border": {
			"radius": true,
			"color": true,
			"style": true,
			"width": true
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--surface)",
			"text": "var(--wp--preset--color--body)"
		},
		"typography": {
			"fontFamily": "ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
			"fontSize": "1.0938rem",
			"lineHeight": "1.72"
		},
		"elements": {
			"link": {
				"color": { "text": "#9c3b22" }
			},
			"heading": {
				"color": { "text": "var(--wp--preset--color--ink)" },
				"typography": {
					"fontWeight": "700",
					"lineHeight": "1.18",
					"letterSpacing": "-0.022em"
				}
			}
		}
	}
}
